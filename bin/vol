#!/usr/bin/env bash
# Громкость/микрофон + всплывающее уведомление (mako).
# Используется в binds: vol up | vol down | vol mute | vol mic
case "${1:-}" in
  up)   wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
  down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  mic)  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
  *) echo "usage: vol up|down|mute|mic"; exit 1 ;;
esac

if [ "$1" = "mic" ]; then
  M="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)"
  case "$M" in *MUTED*) TXT="Микрофон выключен";; *) TXT="Микрофон включён";; esac
  notify-send -h string:x-canonical-private-synchronous:volume -t 1200 "Микрофон" "$TXT"
else
  V="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print $2}')"
  P="$(awk -v v="$V" 'BEGIN{printf "%d%%", v*100}')"
  MSG="$P"
  case "$(wpctl get-volume @DEFAULT_AUDIO_SINK@)" in *MUTED*) MSG="$P (выкл)";; esac
  notify-send -h string:x-canonical-private-synchronous:volume -t 900 "Громкость" "$MSG"
fi
